        "stem": {
          "kind": "markdown",
          "value": "A client who had abdominal surgery 6 hours ago reports pain of 8 on a scale of 0 to 10. Which action should the nurse take first?"
        },
        "rationale": {
          "general": {
            "kind": "markdown",
            "value": "Assessment comes before intervention. New, severe pain after surgery can signal a complication, so the nurse assesses the incision and vital signs before choosing a comfort measure."
          }
        },
        "type": "multiple_choice",
        "content": {
          "options": [
            {
              "id": "opt_a",
              "label": "Reposition the client and reassess in 1 hour"
            },
            {
              "id": "opt_b",
              "label": "Assess the incision site and the client's vital signs"
            },
            {
              "id": "opt_c",
              "label": "Encourage the client to use the incentive spirometer"
            },
            {
              "id": "opt_d",
              "label": "Document the pain rating in the client's record"
            }
          ]
        },
        "answerKey": {
          "correctOptionId": "opt_b"
        },
        "scoring": {
          "model": "zero_one",
          "maxPoints": 1
        }
      }
