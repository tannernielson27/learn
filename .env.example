# Copy to .env.local for local development. Never commit .env.local.
# Public variables are exposed to the browser and must be prefixed NEXT_PUBLIC_.

# --- Supabase (Sprint 4) ---
# Project URL: Supabase dashboard > Project Settings > Data API.
# Local stack (`pnpm exec supabase start`): http://127.0.0.1:55321 (ports are 553xx so another local Supabase project can run alongside)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): Project Settings > API Keys. Safe in the browser;
# row level security is what protects data. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Demo account (#115) ---
# Server only, never NEXT_PUBLIC_. When both are set, /sign-in shows "Use the demo account", which
# signs in to this shared instructor account with no email. Leave empty to hide it. Local stack:
# demo@learn.test / learn-demo-local (supabase/seed-demo.sql). Hosted: production only, created by
# hand (docs/05 §7.3); leave these empty in the Vercel Preview scope. Turn off before real students.
# Both sign-in paths are limited per IP on a deployment (#134): 20 demo sign-ins and 30 emailed
# links per five minutes, per address. The limiter only runs on Vercel, so local runs and the e2e
# suite are unaffected. See src/lib/auth/signInRateLimit.ts.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# --- Live sessions (#128) ---
# Secret key (sb_secret_...): Project Settings > API Keys. Server only, never NEXT_PUBLIC_.
# Resolving a join code is the one thing RLS cannot express — the person typing the code has not
# signed in — so public.resolve_session_code is granted to the service role and to nobody else.
# Without this set, starting and running a session still works; joining one cannot.
# Local stack: `pnpm exec supabase status -o env` prints SECRET_KEY.
SUPABASE_SECRET_KEY=

# --- Live sessions: answering (#131, #133) ---
# Nothing to set. #131 shipped a LIVE_PARTICIPANT_SECRET that signed a bearer token for
# /api/live/view and /api/live/submit, alongside #129's httpOnly participant cookie. #133 kept the
# cookie and deleted the bearer token: the secret in it is drawn by Postgres, only its hash is
# stored, and `resume_participant` is what checks it — so there is no signing key to set, to
# rotate, or to leak. If you set LIVE_PARTICIPANT_SECRET on a deployment, you can remove it.

# --- Live sessions: the private session channel (#149) ---
# Server only, never NEXT_PUBLIC_. REQUIRED for a student to open a live session: the play page and
# POST /api/live/channel sign each phone a 30-minute Realtime token with it, after checking the
# participant cookie. The token lets that phone's socket into its own session's private channel
# and nowhere else. Without this set, the student page fails with an error naming this variable.
#
# It must be a key the Supabase project itself trusts for JWTs. Either:
#   * the legacy JWT secret (a plain string): Project Settings > JWT Keys > "Legacy JWT Secret".
#     Only available while the project still has it (not revoked); or
#   * an ES256 private key you generated and imported, pasted as the one-line JSON JWK including
#     its "kid": `pnpm exec supabase gen signing-key --algorithm ES256`, then JWT Keys > create
#     standby key > import, then Rotate. (Supabase never lets a key it generated be extracted.)
# WARNING: either one can sign a token for any Postgres role, service_role included. Treat it
# exactly like SUPABASE_SECRET_KEY. Each Supabase project has its own; Production and Preview each
# get their own project's key.
# Local stack: `pnpm exec supabase status -o env` prints it as JWT_SECRET.
SUPABASE_JWT_SIGNING_KEY=

# `pnpm db:types` generates from the local stack and needs no token.
# SUPABASE_ACCESS_TOKEN is only for CLI commands against the hosted project (db push, link).
# SUPABASE_ACCESS_TOKEN=
