# Copy to .env.local for local development. Never commit .env.local.
# Public variables are exposed to the browser and must be prefixed NEXT_PUBLIC_.

# --- Supabase (Sprint 4) ---
# Project URL: Supabase dashboard > Project Settings > Data API.
# Local stack (`pnpm exec supabase start`): http://127.0.0.1:55321 (ports are 553xx so another local Supabase project can run alongside)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...): Project Settings > API Keys. Safe in the browser;
# row level security is what protects data. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Demo account (#115) ---
# Server only, never NEXT_PUBLIC_. When both are set, /sign-in shows "Use the demo account", which
# signs in to this shared instructor account with no email. Leave empty to hide it. Local stack:
# demo@learn.test / learn-demo-local (supabase/seed-demo.sql). Hosted: production only, created by
# hand (docs/05 §7.3); leave these empty in the Vercel Preview scope. Turn off before real students.
# Both sign-in paths are limited per IP on a deployment (#134): 20 demo sign-ins and 30 emailed
# links per five minutes, per address. The limiter only runs on Vercel, so local runs and the e2e
# suite are unaffected. See src/lib/auth/signInRateLimit.ts.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# --- Live sessions (#128) ---
# Secret key (sb_secret_...): Project Settings > API Keys. Server only, never NEXT_PUBLIC_.
# Resolving a join code is the one thing RLS cannot express — the person typing the code has not
# signed in — so public.resolve_session_code is granted to the service role and to nobody else.
# Without this set, starting and running a session still works; joining one cannot.
# Local stack: `pnpm exec supabase status -o env` prints SECRET_KEY.
SUPABASE_SECRET_KEY=

# --- Live sessions: answering (#131) ---
# Signs the bearer token a participant presents on /api/live/view and /api/live/submit. A live
# session's participants are not accounts, so this is what says which participant in which session
# a request speaks for; a participant id a browser could simply assert would let anyone answer as
# anyone. Server only, never NEXT_PUBLIC_, and at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Without it set, a room can still be started, run and watched; nobody can answer.
LIVE_PARTICIPANT_SECRET=

# `pnpm db:types` generates from the local stack and needs no token.
# SUPABASE_ACCESS_TOKEN is only for CLI commands against the hosted project (db push, link).
# SUPABASE_ACCESS_TOKEN=
